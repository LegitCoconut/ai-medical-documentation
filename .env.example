MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=phc
AUTH_SECRET=dev-secret-change-me

# ---- LLM (OpenAI-compatible: Ollama OR a hosted gateway) ----
LLM_ENABLED=false
# Local Ollama:
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b-instruct-q4_K_M

# Online models via Vercel AI Gateway (same API, just re-point + key):
# LLM_ENABLED=true
# LLM_PROVIDER=openai            # or "ollama" for local; auto-detected if unset
# LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
# LLM_MODEL=anthropic/claude-sonnet-4.5
# LLM_API_KEY=                   # AI Gateway API key (or set AI_GATEWAY_API_KEY)
# (also accepts VERCEL_OIDC_TOKEN for OIDC auth)

# Whisper speech-to-text
# whisper.cpp HTTP server:  WHISPER_BASE_URL=http://localhost:8080
# OpenAI-compat (e.g. ollama with audio): WHISPER_BASE_URL=http://localhost:11434/v1
WHISPER_BASE_URL=http://localhost:8080
WHISPER_MODEL=whisper-1